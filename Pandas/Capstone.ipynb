    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "df = pd.read_csv(\n",
    "    data/diabetes,
    ")\n",
    "\n",
    "print(\"\\n<------- Original Dataset ------->\")\n",
    "print(df)\n",
    "\n",
    "print(\"\\n<------- Information of Dataset ------->\")\n",
    "df.info()\n",
    "\n",
    "print(\"\\n<------- Statistical Summary ------->\")\n",
    "print(df.describe().round(1))\n",
    "\n",
    "\n",
    "\n",
    "col = [\"Glucose\", \"BloodPressure\", \"SkinThickness\", \"Insulin\", \"BMI\"]\n",
    "\n",
    "# Replace invalid 0 values with NaN\n",
    "df[col] = df[col].replace(0, np.nan)\n",
    "\n",
    "# Fill missing values with column mean\n",
    "df[col] = df[col].fillna(df[col].mean())\n",
    "\n",
    "print(\"\\n<------- Updated Dataset Information ------->\")\n",
    "df.info()\n",
    "\n",
    "mean_comparison = (\n",
    "    df.groupby(\"Outcome\")[[\"Glucose\", \"Insulin\", \"BMI\", \"Age\"]]\n",
    "    .mean()\n",
    "    .round(1)\n",
    ")\n",
    "\n",
    "print(\"\\n<------- Mean Comparison by Outcome ------->\")\n",
    "print(mean_comparison)\n",
    "\n",
    "\n",
    "bins = [-float(\"inf\"), 18.5, 25, 30, float(\"inf\")]\n",
    "\n",
    "labels = [\n",
    "    \"Under Weight\",\n",
    "    \"Normal\",\n",
    "    \"Over Weight\",\n",
    "    \"Obese\"\n",
    "]\n",
    "\n",
    "df[\"BMI_Category\"] = pd.cut(\n",
    "    df[\"BMI\"],\n",
    "    bins=bins,\n",
    "    labels=labels\n",
    ")\n",
    "\n",
    "bmi_counts = df[\"BMI_Category\"].value_counts()\n",
    "\n",
    "print(\"\\n<------- BMI Category Counts ------->\")\n",
    "print(bmi_counts)\n",
    "\n",
    "\n",
    "print(\"\\n<------- Findings ------->\")\n",
    "\n",
    "print(\"1. Patients with diabetes have a higher average glucose level than non-diabetic patients.\")\n",
    "\n",
    "print(\"2. Patients with diabetes have a higher average BMI than non-diabetic patients.\")\n",
    "\n",
    "print(\"3. Most patients fall into the Over Weight or Obese BMI categories.\")\n",
    "\n",
    "\n",
    "\n",
    "plt.figure(figsize=(6,4))\n",
    "\n",
    "plt.bar(\n",
    "    mean_comparison.index,\n",
    "    mean_comparison[\"Glucose\"],\n",
    "    color=[\"skyblue\", \"salmon\"]\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Outcome\")\n",
    "plt.ylabel(\"Mean Glucose\")\n",
    "plt.title(\"Mean Glucose by Diabetes Outcome\")\n",
    "\n",
    "plt.xticks([0,1],[\"Non-Diabetic\",\"Diabetic\"])\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "plt.figure(figsize=(6,6))\n",
    "\n",
    "plt.pie(\n",
    "    bmi_counts,\n",
    "    labels=bmi_counts.index,\n",
    "    autopct=\"%1.1f%%\",\n",
    "    startangle=90,\n",
    "    colors=[\"gold\", \"lightgreen\", \"lightskyblue\", \"lightcoral\"]\n",
    ")\n",
    "\n",
    "plt.title(\"Distribution of BMI Categories\")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.show()"
   ]
